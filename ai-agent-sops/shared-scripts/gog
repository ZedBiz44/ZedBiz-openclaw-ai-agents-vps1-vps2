#!/bin/sh
set -eu

gog_home="${GOG_HOME:-${HOME}/.openclaw/gogcli}"
keyring_env="${gog_home}/keyring.env"

if [ -r "${keyring_env}" ]; then
  # This file contains only the per-agent keyring password and is never committed.
  . "${keyring_env}"
  export GOG_KEYRING_PASSWORD
fi

export GOG_HOME="${gog_home}"
export GOG_KEYRING_BACKEND="${GOG_KEYRING_BACKEND:-file}"

email_mode_file="${gog_home}/email-mode"
if [ -r "${email_mode_file}" ] && [ "$(tr -d '\r\n' < "${email_mode_file}")" = "draft_only" ]; then
  set -- --gmail-no-send "$@"
fi

exec /opt/openclaw/shared/bin/gog-real "$@"

