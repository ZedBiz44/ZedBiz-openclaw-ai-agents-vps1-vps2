#!/usr/bin/env bash
# Retrieve one WordPress MCP bearer token from the dedicated 1Password vault
# and use it directly in an MCP request. Never prints the token.
set -euo pipefail

readonly VAULT="wordpress-mcp"
readonly CREDENTIAL_FILE="${OPENCLAW_STATE_DIR:-/home/node/.openclaw}/credentials/onepassword/service-account-token"
readonly OP_BIN="${CLAW_1PASSWORD_OP:-/usr/local/bin/op}"

usage() {
  cat <<'USAGE'
Usage:
  wp-mcp-1password discover <domain-or-url>
  wp-mcp-1password call <domain-or-url> <tool-name> <arguments-json>

Examples:
  wp-mcp-1password discover zedwebhosting.com
  wp-mcp-1password call zedwebhosting.com wp_get_posts '{"per_page":5}'
USAGE
}

normalize_domain() {
  local value="$1"
  value="${value#http://}"
  value="${value#https://}"
  value="${value%%/*}"
  value="${value,,}"
  value="${value%.}"
  printf '%s' "$value"
}

require_dependency() {
  command -v "$1" >/dev/null 2>&1 || {
    printf 'Required command not available: %s\n' "$1" >&2
    exit 127
  }
}

mcp_request() {
  local endpoint="$1"
  local payload="$2"
  local header_config response_file exit_code
  response_file="$(mktemp)"
  trap 'rm -f "$response_file"' RETURN

  header_config="$(printf 'header = "Authorization: Bearer %s"\nheader = "Content-Type: application/json"\n' "$wp_token")"
  set +e
  printf '%s' "$header_config" | curl --config - --silent --show-error --fail-with-body \
    --connect-timeout 15 --max-time 45 \
    --request POST "$endpoint" --data-binary "$payload" >"$response_file"
  exit_code=$?
  set -e

  if [ "$exit_code" -eq 0 ]; then
    if jq -e . "$response_file" >/dev/null 2>&1; then
      jq --arg endpoint "$endpoint" '{endpoint: $endpoint, response: .}' "$response_file"
    else
      printf 'Verified endpoint: %s\n' "$endpoint"
      cat "$response_file"
    fi
    return 0
  fi
  return "$exit_code"
}

main() {
  require_dependency "$OP_BIN"
  require_dependency curl
  require_dependency jq

  if [ ! -r "$CREDENTIAL_FILE" ]; then
    printf 'Wilma 1Password credential file is missing or unreadable. Stop and diagnose.\n' >&2
    exit 1
  fi
  if [ "$#" -lt 2 ]; then
    usage >&2
    exit 2
  fi

  local action="$1"
  local domain item item_json site_url base payload endpoint wp_token
  domain="$(normalize_domain "$2")"
  if [ -z "$domain" ]; then
    printf 'A valid domain is required.\n' >&2
    exit 2
  fi
  item="wp-mcp-key-${domain//./-}"

  export OP_SERVICE_ACCOUNT_TOKEN
  OP_SERVICE_ACCOUNT_TOKEN="$(cat "$CREDENTIAL_FILE")"
  export OP_LOAD_DESKTOP_APP_SETTINGS=false
  export OP_BIOMETRIC_UNLOCK_ENABLED=false

  item_json="$($OP_BIN item get "$item" --vault "$VAULT" --format json --cache=false)"
  site_url="$(jq -er '.fields[] | select(.label == "url") | .value' <<<"$item_json")"
  wp_token="$(jq -er '.fields[] | select(.label == "credential") | .value' <<<"$item_json")"
  unset item_json
  unset OP_SERVICE_ACCOUNT_TOKEN

  base="${site_url%/}"
  case "$action" in
    discover)
      payload='{"jsonrpc":"2.0","id":1,"method":"tools/list"}'
      ;;
    call)
      if [ "$#" -ne 4 ]; then
        usage >&2
        exit 2
      fi
      jq -e . >/dev/null <<<"$4" || {
        printf 'Tool arguments must be valid JSON.\n' >&2
        exit 2
      }
      payload="$(jq -cn --arg name "$3" --argjson arguments "$4" '{jsonrpc:"2.0",id:1,method:"tools/call",params:{name:$name,arguments:$arguments}}')"
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac

  # Pro sites normally use v2; Basic and legacy sites use v1. No endpoint is stored
  # unless a site has a verified exception.
  for endpoint in "$base/wp-json/mcp/v2/http" "$base/wp-json/mcp/v1/http"; do
    if mcp_request "$endpoint" "$payload"; then
      unset wp_token
      return 0
    fi
  done
  unset wp_token
  printf 'No standard MCP endpoint succeeded for %s. Stop and diagnose; do not guess or reveal credentials.\n' "$domain" >&2
  exit 1
}

main "$@"
