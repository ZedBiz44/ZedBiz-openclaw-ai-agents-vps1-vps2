ARG BASE_IMAGE=zedbiz/openclaw-base:2026.10.4-victor-20261017
FROM ${BASE_IMAGE}
ARG DOCKER_CLI_VERSION=29.8.2
USER root
RUN apt-get update -qq && apt-get install -y -q --no-install-recommends openssh-client ca-certificates curl tar \
    && curl -fsSL "https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_CLI_VERSION}.tgz" \
      | tar -xz -C /tmp --strip-components=1 docker/docker \
    && mv /tmp/docker /usr/local/bin/docker \
    && chmod 0755 /usr/local/bin/docker \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/patch-dynamic-memory-10-4.cjs /opt/zedbiz/patch-dynamic-memory-10-4.cjs
RUN node /opt/zedbiz/patch-dynamic-memory-10-4.cjs /app/dist/diagnostic-DxMcmqTS.mjs \
    && node --check /app/dist/diagnostic-DxMcmqTS.mjs
USER node
