# Safe performance settings for VPS1's four-core x86 Linux host.
HINDSIGHT_API_RERANKER_PROVIDER=flashrank
HINDSIGHT_API_RERANKER_FLASHRANK_MODEL=ms-marco-TinyBERT-L-2-v2
HINDSIGHT_API_RERANKER_MAX_CANDIDATES=50
HINDSIGHT_API_WORKER_MAX_SLOTS=4
HINDSIGHT_API_WORKER_CONSOLIDATION_MAX_SLOTS=1

# Keep credentials and provider keys only in the live protected .env file.
