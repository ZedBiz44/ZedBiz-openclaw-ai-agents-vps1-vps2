# Safe performance settings for VPS1's four-core x86 Linux host.
HINDSIGHT_API_RERANKER_PROVIDER=flashrank
HINDSIGHT_API_RERANKER_FLASHRANK_MODEL=ms-marco-TinyBERT-L-2-v2
HINDSIGHT_API_RERANKER_MAX_CANDIDATES=50
HINDSIGHT_API_WORKER_MAX_SLOTS=4
HINDSIGHT_API_WORKER_CONSOLIDATION_MAX_SLOTS=1

# Keep credentials and provider keys only in the live protected .env file.

# Operation-specific model routing (OpenRouter)
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=https://openrouter.ai/api/v1
HINDSIGHT_API_LLM_MODEL=openai/gpt-5.6-luna
HINDSIGHT_API_LLM_REASONING_EFFORT=low
HINDSIGHT_API_RETAIN_LLM_MODEL=openai/gpt-5.6-luna
HINDSIGHT_API_RETAIN_LLM_REASONING_EFFORT=low
HINDSIGHT_API_CONSOLIDATION_LLM_MODEL=openai/gpt-5.6-luna
HINDSIGHT_API_CONSOLIDATION_LLM_REASONING_EFFORT=low
HINDSIGHT_API_REFLECT_LLM_MODEL=openai/gpt-oss-120b
HINDSIGHT_API_REFLECT_LLM_REASONING_EFFORT=low
